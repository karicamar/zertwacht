<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zertwacht.Cli</AssemblyName>
    <RootNamespace>Zertwacht.Cli</RootNamespace>

    <!-- Installable with: dotnet tool install -g Zertwacht -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zertwacht</ToolCommandName>
    <PackageId>Zertwacht</PackageId>
    <Version>1.0.0</Version>
    <Authors>Amar Karic</Authors>
    <Description>TLS certificate monitor: expiry, weak keys, SHA-1 signatures, name mismatches, incomplete chains and overlong lifetimes for your endpoints and certificate files.</Description>
    <PackageTags>tls;certificates;x509;monitoring;security;devops</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/karicamar/zertwacht</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zertwacht.Core\Zertwacht.Core.csproj" />
  </ItemGroup>

</Project>
